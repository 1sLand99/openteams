{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "append_prompt": {
      "title": "Append Prompt",
      "description": "Extra text appended to the prompt",
      "type": [
        "string",
        "null"
      ],
      "format": "textarea",
      "default": null
    },
    "harness_path": {
      "title": "DeepSeek Harness Checkout",
      "description": "Absolute path to a built deepseek-ai/deepseek-harness checkout. Defaults to ~/deepseek-harness",
      "type": [
        "string",
        "null"
      ]
    },
    "acp_config_path": {
      "title": "ACP Composition",
      "description": "Absolute path to the Cordis ACP composition. Defaults to examples/acp-agent/cordis.yml inside the checkout",
      "type": [
        "string",
        "null"
      ]
    },
    "acp": {
      "description": "Partial ACP settings. `None` means inherit from the lower-priority layer.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "access_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "workspace_only",
            "full_access",
            null
          ]
        },
        "approval_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ask",
            "auto_allow",
            "auto_reject",
            null
          ]
        },
        "auth": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "auto"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "method_id": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "method_id"
                    }
                  },
                  "required": [
                    "type",
                    "method_id"
                  ]
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "additional_directories": {
          "description": "`Some` replaces lower-priority directories, including with an empty list.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "config_overrides": {
          "description": "Exact option IDs and typed values advertised by the ACP Agent.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "properties": {
              "option_id": {
                "type": "string"
              },
              "value": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "const": "value_id"
                      }
                    },
                    "required": [
                      "type",
                      "value"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "boolean"
                      },
                      "type": {
                        "type": "string",
                        "const": "boolean"
                      }
                    },
                    "required": [
                      "type",
                      "value"
                    ]
                  }
                ]
              },
              "label_snapshot": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "category_snapshot": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "option_id",
              "value"
            ]
          }
        }
      }
    },
    "base_command_override": {
      "title": "Base Command Override",
      "description": "Override the base command with a custom command",
      "type": [
        "string",
        "null"
      ]
    },
    "additional_params": {
      "title": "Additional Parameters",
      "description": "Additional parameters to append to the base command",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "env": {
      "title": "Environment Variables",
      "description": "Environment variables to set when running the executor",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "type": "object"
}